# Local Supabase values are printed by `npx supabase start` / `npx supabase status`.
# Copy this file to .env. On a physical device, replace 127.0.0.1 with your
# machine's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-local-anon-key

# RevenueCat public SDK keys are platform-specific. These values ship in the
# client bundle, so use only public app-specific or Test Store keys here —
# never a RevenueCat secret API key. Leave them blank for the safe free-tier
# fallback used by local builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=

# Optional. Leave blank to use RevenueCat's current offering.
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# Local simulator QA only. Set to 1 to exercise premium screens without a
# purchase. Application code ignores this override in production builds.
EXPO_PUBLIC_ATRIUM_DEV_PREMIUM_ACCESS=

# AI Coach provider keys are server secrets. Never add one to this mobile
# environment file or any EXPO_PUBLIC_ variable. See docs/AI_COACH_SETUP.md.
