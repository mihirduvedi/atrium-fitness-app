{
  "expo": {
    "name": "Atrium",
    "slug": "atrium",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atrium",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.atrium.mobile.mihir"
    },
    "android": {
      "package": "app.atrium.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBFBF9",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Atrium lets you choose progress photos to store privately on this device.",
          "cameraPermission": "Atrium lets you take progress photos to store privately on this device."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Atrium uses sleep, heart, step, and workout data to tune readiness.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBF9",
          "dark": { "backgroundColor": "#1A1918" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
