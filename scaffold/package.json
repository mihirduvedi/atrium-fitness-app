{
  "name": "atrium",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "coach:eval": "npm run coach:eval --workspace mobile",
    "coach:gate": "npm run coach:gate --workspace mobile",
    "coach:smoke:local": "node scripts/coach-local-smoke.mjs",
    "coach:groq:check": "node scripts/check-coach-groq-config.mjs",
    "coach:eval:groq": "npm run coach:eval:groq --workspace mobile",
    "coach:gate:groq": "npm run coach:gate:groq --workspace mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mobile": "npm run start --workspace mobile"
  },
  "devDependencies": {
    "supabase": "^2.30.4"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
